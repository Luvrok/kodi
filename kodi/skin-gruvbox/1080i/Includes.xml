<?xml version="1.0" encoding="UTF-8"?>
<!-- auto-loaded by kodi: the skin's shared pieces. constants first, then
     the primitives everything else uses -->
<includes>
	<include file="Defaults.xml"/>
	<include file="Constants.xml"/>

	<!-- the page background: one white.png tinted bg, no fanart, no blur -->
	<include name="Gruvbox_Background">
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>screen_w</width>
			<height>screen_h</height>
			<texture colordiffuse="bg">common/white.png</texture>
		</control>
	</include>

	<!-- a 1px hairline across the page. params: top -->
	<include name="Gruvbox_Hairline">
		<control type="image">
			<left>page_margin</left>
			<top>$PARAM[top]</top>
			<width>page_width</width>
			<height>rule_h</height>
			<texture colordiffuse="hairline">common/white.png</texture>
		</control>
	</include>

	<!-- 1px accent frame around a focused tile's poster. for a
	     focusedlayout only: no visible condition, kodi shows it on focus.
	     drawn as four white.png strips tinted accent, poster_w x poster_h -->
	<include name="Gruvbox_FocusFrame">
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>poster_w</width>
			<height>rule_h</height>
			<texture colordiffuse="accent">common/white.png</texture>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>rule_h</width>
			<height>poster_h</height>
			<texture colordiffuse="accent">common/white.png</texture>
		</control>
		<control type="image">
			<left>139</left>
			<top>0</top>
			<width>rule_h</width>
			<height>poster_h</height>
			<texture colordiffuse="accent">common/white.png</texture>
		</control>
		<control type="image">
			<left>0</left>
			<top>209</top>
			<width>poster_w</width>
			<height>rule_h</height>
			<texture colordiffuse="accent">common/white.png</texture>
		</control>
	</include>

	<!-- one hint chip, quickshell's `key -> what`. params: key, what -->
	<include name="Gruvbox_Hint">
		<control type="label">
			<width>auto</width>
			<height>hint_h</height>
			<font>mono_12</font>
			<textcolor>accent</textcolor>
			<label>$PARAM[key]</label>
		</control>
		<control type="label">
			<width>auto</width>
			<height>hint_h</height>
			<font>mono_12</font>
			<textcolor>text_secondary</textcolor>
			<label>$PARAM[what]</label>
		</control>
	</include>
</includes>
