<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="skin.gruvbox" version="1.0.0" name="Gruvbox" provider-name="Luvrok">
	<requires>
		<import addon="xbmc.gui" version="5.17.0"/>
		<import addon="script.skinvariables" version="2.1.21"/>
		<import addon="plugin.video.themoviedb.helper" version="4.0.0" optional="true"/>
		<import addon="script.embuary.helper" version="2.0.0" optional="true"/>
	</requires>
	<extension point="xbmc.gui.skin" debugging="false" effectslowdown="1">
		<res width="1920" height="1080" aspect="16:9" default="true" folder="1080i"/>
	</extension>
	<extension point="xbmc.addon.metadata">
		<summary lang="en_GB">Gruvbox - a dense, fast index for your library.</summary>
		<description lang="en_GB">A fork of Majan re-skinned to the gruvbox of the quickshell desktop: JetBrains Mono, square hairlines, no blur. Films, shows, actors, directors and the movie pipe downloads.</description>
		<platform>all</platform>
		<license>GPL-2.0-or-later</license>
		<assets>
			<icon>resources/icon.png</icon>
			<fanart>resources/fanart.jpg</fanart>
		</assets>
	</extension>
</addon>
